# backend/.env.example
# Copy to backend/.env and fill in real values. backend/.env is
# git-ignored and must never be committed.
#
# Loaded by config/settings.py via python-dotenv.

# ── Core ────────────────────────────────────────────────────
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
DEBUG=True

# When DEBUG=False, this must be an explicit list. `*` is rejected
# at startup in that mode by config/settings.py.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS (comma-separated) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Security ────────────────────────────────────────────────
# Set true only behind HTTPS. When true, session and CSRF cookies
# are marked Secure.
USE_HTTPS=false

# ── Database (application user) ─────────────────────────────
DB_NAME=quiz
DB_USER=quiz
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=3306

# ── Database (administrative user, used only by `manage.py bootstrap`) ──
# Preferred over the --db-admin-user / --db-admin-password CLI flags,
# because CLI values are visible in `ps` and shell history.
# On a Debian/Ubuntu default install with Unix-socket auth, leave
# the password empty and run bootstrap via sudo.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ── Uploads ─────────────────────────────────────────────────
# Size in bytes. 52428800 = 50 MB.
MAX_UPLOAD_SIZE=52428800
# State export/import share these limits, so a successfully exported state
# file is always accepted by the same deployment.
MAX_STATE_TRANSFER_SIZE=52428800
MAX_STATE_IMPORT_QUESTIONS=100000

# ── Cache ───────────────────────────────────────────────────
# MemcachedCache or RedisCache. An unrecognized value is a hard
# startup failure.
CACHE_TYPE=MemcachedCache
MEMCACHED_LOCATION=127.0.0.1:11211
# REDIS_URL=redis://localhost:6379/1

# ── Audit log retention ─────────────────────────────────────
PRIVILEGED_ACTION_RETENTION_DAYS=365

# ── Seeded pro-user accounts ────────────────────────────────
# One-time password handed to the seeded pro/moderator accounts.
# Every seeded account is created with must_change_password=True,
# so this value is rotated on first login by each user.
SEED_PRO_USER_PASSWORD=1234test
